# Copie este arquivo para .env.ai e informe a chave do projeto OpenAI.
OPENAI_API_KEY=
ASSISTANT_MODE=local
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-realtime-whisper
OPENAI_TIMEOUT=45
ASSISTANT_DAILY_LIMIT=40
ASSISTANT_MAX_INPUT_TOKENS=4000
ASSISTANT_MAX_OUTPUT_TOKENS=800

# Leitura de fichas técnicas no cadastro de modelos.
# local = gratuito; hybrid/openai = complementa as regras com a API configurada.
MODEL_SHEET_READER_MODE=local
MODEL_SHEET_READER_MODEL=gpt-5.6-luna
MODEL_SHEET_READER_MAX_CHARS=80000
MODEL_SHEET_READER_PDF_DETAIL=auto
